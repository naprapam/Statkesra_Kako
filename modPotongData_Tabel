Option Explicit

Public Sub PotongDataTabel()

    Dim wbSumber As Workbook
    Dim wbOutput As Workbook

    Dim wsSumber As Worksheet
    Dim wsOutput As Worksheet

    Dim filePath As Variant
    Dim savePath As String
    Dim folderPath As String

    Dim keyword As String

    Dim firstKakoRow As Long
    Dim targetRow As Long
    Dim endRow As Long

    Dim lastRow As Long
    Dim LastCol As Long

    Dim r As Long
    Dim found As Boolean
    Dim kakoCol As Long

    keyword = Trim(InputBox( _
        "Masukkan kode atau nama kabupaten/kota." & vbCrLf & _
        "Contoh : 6305 atau TAPIN", _
        "Potong Data"))

    If keyword = "" Then Exit Sub

    filePath = Application.GetOpenFilename( _
        "Excel Files (*.xlsx),*.xlsx", , _
        "Pilih Gabung_Data.xlsx")

    If filePath = False Then Exit Sub

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False

    Set wbSumber = Workbooks.Open(filePath, ReadOnly:=True)

    Set wbOutput = Workbooks.Add

    wbOutput.Worksheets(1).Name = "TEMP"

    For Each wsSumber In wbSumber.Worksheets

        ' ======================
        ' SKIP TABEL KONSUMSI
        ' ======================
        If UCase(wsSumber.Name) = "NONUM" _
        Or UCase(wsSumber.Name) = "NONUMA" _
        Or UCase(wsSumber.Name) = "NONUMB" Then

            GoTo NextSheet

        End If

        found = False
        firstKakoRow = 0
        targetRow = 0
        kakoCol = 0

        lastRow = LastUsedRow(wsSumber)
        LastCol = LastUsedCol(wsSumber)

        ' Cari KAKO pertama
        For r = 1 To lastRow

            kakoCol = CariKodeWilayahDiBaris( _
                        wsSumber, r, LastCol)

            If kakoCol > 0 Then

                firstKakoRow = r
                Exit For

            End If

        Next r

        If firstKakoRow = 0 Then GoTo NextSheet

        ' Cari kabupaten target
        For r = firstKakoRow To lastRow

            If InStr( _
                1, _
                UCase(CStr( _
                wsSumber.Cells(r, kakoCol).Value)), _
                UCase(keyword)) > 0 Then

                targetRow = r
                found = True

                Exit For

            End If

        Next r

        If Not found Then GoTo NextSheet

        endRow = lastRow

        ' Cari KAKO berikutnya
        For r = targetRow + 1 To lastRow

            If IsKodeWilayah( _
                CStr(wsSumber.Cells(r, kakoCol).Value)) Then

                endRow = r - 1
                Exit For

            End If

        Next r

        Set wsOutput = wbOutput.Worksheets.Add( _
            After:=wbOutput.Worksheets( _
            wbOutput.Worksheets.Count))

        On Error Resume Next
        wsOutput.Name = Left(wsSumber.Name, 31)
        On Error GoTo 0

        ' Salin header
        If firstKakoRow > 1 Then

            wsSumber.Rows( _
                "1:" & firstKakoRow - 1).Copy _
                wsOutput.Rows(1)

        End If

        ' Salin blok KAKO
        wsSumber.Rows( _
            targetRow & ":" & endRow).Copy _
            wsOutput.Rows(firstKakoRow)

NextSheet:

    Next wsSumber

    On Error Resume Next
    wbOutput.Worksheets("TEMP").Delete
    On Error GoTo 0

    folderPath = Left( _
        CStr(filePath), _
        InStrRev(CStr(filePath), "\"))

    savePath = folderPath & "Data_Potong.xlsx"

    wbOutput.SaveAs savePath

    wbOutput.Close True
    wbSumber.Close False

    Application.DisplayAlerts = True
    Application.ScreenUpdating = True

    MsgBox _
        "Data_Potong berhasil dibuat." & vbCrLf & _
        savePath, _
        vbInformation

End Sub

Private Function CariKodeWilayahDiBaris( _
    ws As Worksheet, _
    ByVal RowNum As Long, _
    ByVal LastCol As Long) As Long

    Dim c As Long

    For c = 1 To LastCol

        If IsKodeWilayah( _
            CStr(ws.Cells(RowNum, c).Value)) Then

            CariKodeWilayahDiBaris = c
            Exit Function

        End If

    Next c

End Function

Private Function IsKodeWilayah( _
    ByVal txt As String) As Boolean

    txt = Trim(txt)

    If Len(txt) < 6 Then Exit Function

    If Mid(txt, 5, 1) = "." Then

        If IsNumeric(Left(txt, 4)) Then

            IsKodeWilayah = True

        End If

    End If

End Function

Private Function LastUsedRow( _
    ws As Worksheet) As Long

    Dim rng As Range

    Set rng = ws.Cells.Find( _
                "*", , , , _
                xlByRows, _
                xlPrevious)

    If rng Is Nothing Then
        LastUsedRow = 1
    Else
        LastUsedRow = rng.Row
    End If

End Function

Private Function LastUsedCol( _
    ws As Worksheet) As Long

    Dim rng As Range

    Set rng = ws.Cells.Find( _
                "*", , , , _
                xlByColumns, _
                xlPrevious)

    If rng Is Nothing Then
        LastUsedCol = 1
    Else
        LastUsedCol = rng.Column
    End If

End Function

